# Copy to .env and point it at your Aseprite program (used by npm run sprites).
# Mac:
ASEPRITE_PATH=/Applications/Aseprite.app/Contents/MacOS/aseprite
# Windows:            ASEPRITE_PATH=C:\Program Files\Aseprite\aseprite.exe
# Windows (Steam):    ASEPRITE_PATH=C:\Program Files (x86)\Steam\steamapps\common\Aseprite\aseprite.exe
